# Web (Next.js)
# EARLY_ACCESS_DISABLED=true
# Show teacher/dev controls (stage jumpers, review flags) in the lab UI.
# NEXT_PUBLIC_EXPERA_DEV_TOOLS=1

# Nest API host root (web appends /api/v1 for modules + waitlist proxy)
MODULES_API_BASE_URL=http://127.0.0.1:4000
# EARLY_ACCESS_API_BASE_URL=http://127.0.0.1:4000

# API (NestJS) — copy to apps/api/.env or repo root for `npm run dev:api`
PORT=4000
WEB_ORIGIN=http://127.0.0.1:3100
# Extra browser origins (comma-separated) for direct API calls if needed
# CORS_ORIGINS=https://expera.iseowoapp.com

# Waitlist persistence: set DB_USERNAME to use MySQL; otherwise JSONL under apps/api/.data/
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=expera
DB_USERNAME=
DB_PASSWORD=
# Dev only — use apps/api/sql/001_waitlist_entries.sql in production
# DB_SYNCHRONIZE=true
# WAITLIST_DATA_DIR=/var/lib/expera/waitlist
